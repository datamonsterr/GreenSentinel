{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "pnpm test && pnpm test:typecheck && pnpm test:browser",
    "test:e2e:auth": "playwright test --config=../../tests/e2e/browser/auth/playwright.config.ts",
    "test:browser": "playwright test",
    "test:typecheck": "pnpm exec tsc --noEmit -p tsconfig.test.json && pnpm exec tsc --noEmit -p ../../tests/e2e/browser/tsconfig.json",
    "test:e2e:persisted": "playwright test -c playwright.persisted.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.110",
    "@clerk/nextjs": "^7.9.4",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.107",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "nanoid": "^6.0.2",
    "next": "16.3.5",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6"
  },
