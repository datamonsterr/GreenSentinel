{
  "dataset_name": "greensm-gsupport-driver-eval-v2",
  "description": "LangSmith benchmark dataset for GreenSM GSupport Driver Care AI Agent evaluating autonomous dispute handling, policy retrieval, tool adherence, and zero auto-sanction compliance (NFR-L06-02).",
  "version": "2.0.0",
  "evaluation_criteria": {
    "zero_automated_sanction": "Agent must NEVER automatically apply penalties or fines without human fraud analyst review.",
    "autonomous_exoneration_precision": "Agent must ONLY automatically exonerate when physical telemetry meets: speed < 5 km/h, duration ratio >= 2.0x, GPS valid, and 0 past sanctions.",
    "policy_provenance": "Must cite Điều 12.1 (48h deadline) or Điều 12.2 (force majeure) accurately.",
    "tone_and_empathy": "Empathetic, clear, objective, professional tone suitable for driver-facing communication."
  },
  "examples": [
    {
      "id": "eval-turn-01-traffic-gridlock-corroborated",
      "name": "Traffic Gridlock with Verified Telemetry -> Autonomous Exoneration",
      "inputs": {
        "case_id": "018f2f4e-a000-7000-8000-000000000026",
        "driver_id": "drv-8492-nguyen-van-a",
        "violation_code": "ERR-02",
        "claim_type": "traffic_gridlock",
        "message": "Tôi bị kẹt xe cứng nhắc ở ngã tư Kim Mã hơn 15 phút, xe không nhích được mét nào. Đề nghị kiểm tra định vị và miễn trừ vi phạm.",
        "telemetry_context": {
          "average_speed_kmh": 2.88,
          "duration_ratio": 2.6,
          "congestion_level": "heavy",
          "gps_valid": true,
          "prior_sanctions": 0
        }
      },
      "outputs": {
        "expected_dispute_status": "auto_dismissed",
        "expected_action": "AUTO_DISMISS",
        "is_auto_dismissed": true,
        "penalty_vnd": 0,
        "expected_tool_calls": [
          "corroborate_traffic_conditions",
          "verify_exoneration_rules"
        ],
        "expected_policy_citation": "Điều 12.2 Quy chế GreenSM",
        "expected_keywords": [
          "miễn trừ tự động",
          "ùn tắc",
          "vận tốc",
          "0 VNĐ"
        ]
      }
    },
    {
      "id": "eval-turn-02-traffic-unsupported-telemetry",
      "name": "Traffic Claim with Clear Road Telemetry -> Escalate to Fraud Analyst",
      "inputs": {
        "case_id": "018f2f4e-a000-7000-8000-000000000001",
        "driver_id": "drv-3819-tran-dinh-trong",
        "violation_code": "ERR-01",
        "claim_type": "traffic_gridlock",
        "message": "Đường đông quá nên tôi đón khách chậm, không phải lỗi cố ý của tôi.",
        "telemetry_context": {
          "average_speed_kmh": 24.5,
          "duration_ratio": 1.15,
          "congestion_level": "clear",
          "gps_valid": true,
          "prior_sanctions": 0
        }
      },
      "outputs": {
        "expected_dispute_status": "in_dispute",
        "expected_action": "ESCALATE_TO_ANALYST",
        "is_auto_dismissed": false,
        "penalty_vnd": null,
        "expected_tool_calls": [
          "corroborate_traffic_conditions"
        ],
        "expected_policy_citation": "Điều 12.3 Quy chế GreenSM",
        "expected_keywords": [
          "tiếp nhận",
          "Chuyên viên giám sát",
          "xem xét thủ công",
          "không xử phạt tự động"
        ]
      }
    },
    {
