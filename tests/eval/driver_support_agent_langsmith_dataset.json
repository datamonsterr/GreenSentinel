    },
    {
      "id": "eval-turn-05-policy-and-deadline-inquiry",
      "name": "Driver General Policy Query -> Cite 48h Window and Rights",
      "inputs": {
        "case_id": "018f2f4e-a000-7000-8000-000000000004",
