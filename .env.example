# ============================================
# AI20K Project GreenSentinel — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# ---- 1. Chat provider (all environments; Gemini default) ----
# LLM_MODEL selects a provider, not a model ID: gemini | openai | openrouter.
LLM_MODEL=gemini
LLM_TEMPERATURE=0.7
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# RAG embeddings are independent of the chat provider. New vectors use a separate
# environment-specific Qdrant collection; re-index policies before querying it.
RAG_EMBEDDING_PROVIDER=openai
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Reasoning is mandatory on GLM 5.3 Flash; low keeps chat latency under DRIVER_AGENT_TIMEOUT_SECONDS.
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional role model override; unset inherits the selected provider model.
DRIVER_AGENT_MODEL=
# Driver GSupport agent end-to-end invocation timeout (seconds). Raise on
# slower deployments (e.g. Railway dev) instead of silently falling back.
DRIVER_AGENT_TIMEOUT_SECONDS=45

# Optional normalized traffic evidence gateway (see docs/testing/manual/TRAFFIC_EVIDENCE.md).
# URLs are deployment configuration, never supplied by an agent/user tool argument.
TRAFFIC_INCIDENTS_URL=
TRAFFIC_API_KEY=
TRAFFIC_TIMEOUT_SECONDS=3

# ---- 2. Database (Railway PostgreSQL) ----
# On Railway: use the reference variable syntax to auto-wire from the Postgres
# service in the same project. This creates a visual connection line in the
# Railway dashboard and auto-rotates when Railway updates credentials.
#
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# For local dev, point to your local Postgres instance:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/postgres

# ---- 3. Redis (Railway Redis) ----
# On Railway: use the reference variable syntax:
#
#   REDIS_URL=${{Redis.REDIS_URL}}
#
# For local dev:
REDIS_URL=redis://localhost:6379/0

# ---- 4. Clerk Authentication ----
# CLERK_SECRET_KEY is required by the Python FastAPI backend to verify Clerk
# JWTs sent in the Authorization header. Without it, auth falls back to JWKS-
# only verification; if JWKS is also unconfigured in production, /cases returns 503.
#
# Get keys from: https://dashboard.clerk.com → API Keys
#
# The NEXT_PUBLIC_* vars are for the Next.js webapp (src/webapp/.env.local).
# The Python backend reads: CLERK_SECRET_KEY, CLERK_JWKS_URL, CLERK_ISSUER.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Derived from the publishable key — set explicitly to avoid decoding at startup:
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
# Optional — leave empty unless your Clerk app has a specific audience configured:
CLERK_AUDIENCE=
# Comma-separated allowed origins for Clerk azp claim validation:
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000,https://green-sentinel.vercel.app,https://greensentinel.vercel.app

# ---- 5. Vector Store (Qdrant Multi-Environment) ----
# Cloud Cluster URL (shared across all environments):
QDRANT_CLUSTER_URL=https://your-qdrant-cluster.cloud.qdrant.io
# Scoped API keys per environment (prod/test/dev collections):
QDRANT_PROD_API_KEY=your-qdrant-prod-policies-token
QDRANT_TEST_API_KEY=your-qdrant-test-policies-token
QDRANT_DEV_API_KEY=your-qdrant-dev-policies-token
# Local Docker fallback:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- 6. App Configuration ----
APP_ENV=development
# Local fixture authorization requires APP_ENV=test; keep false on deployed services.
TEST_AUTH_ENABLED=false
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_BASE_URL=http://localhost:8000

# ---- 7. LangSmith Tracing & Observability ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- 8. Logging ----
LOG_LEVEL=INFO

# ---- 9. AI Hook Logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- 10. Dedicated Jev Decisions and skill selection (independent of chat) ----
JEV_SKILL_MODEL=~typesafe/jev-latest
SKILLS_BANK_PATH=./.agents/jev_skills
JEV_SKILL_API_KEY=sk-or-v1-your-skill-selector-key-here
JEV_SKILL_INJECT_CONTENT=true
PROJECT_JEV_API_KEY=sk-or-v1-your-project-openrouter-key-here
PROJECT_JEV_TEST_API_KEY=sk-or-v1-your-test-openrouter-key-here
PROJECT_JEV_MODEL=inception/mercury-decide:free
JEV_FALLBACK_MODELS=perplexity/pplx-decider-flash-v1.2
JEV_ALLOW_HEURISTIC_FALLBACK=false

# ---- 11. Next.js Webapp ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- 12. Mnemoverse Memory ----
MNEMOVERSE_API_KEY=your-mnemoverse-key-here
MNEMOVERSE_API_URL=https://core.mnemoverse.com/api/v1

# ---- 13. Role E2E accounts (real Clerk UI login, hosted envs only) ----
# Placeholders only. Never commit real passwords.
# Local run: copy these into ignored `.env` (see docs/testing/REAL_ACCOUNT_E2E.md).
# CI/hosted: set the same names as GitHub Actions secrets.
E2E_ANALYST_EMAIL=analyst@example.com
E2E_ANALYST_PASSWORD=change-me
E2E_DRIVER_EMAIL=driver@example.com
E2E_DRIVER_PASSWORD=change-me
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me
# Which deployed frontend/backend the real-account suite targets:
# preview | dev | staging | prod. Base URLs resolve per env with
# AUTH_E2E_FRONTEND_URL / AUTH_E2E_BACKEND_URL overrides taking precedence.
E2E_TARGET_ENV=preview
# Opt-in flag for the real-account suite (keep false by default).
RUN_REAL_ACCOUNT_E2E=false
# Preview only: uncomment and point at the PR-specific URLs from Vercel/Railway comments.
# AUTH_E2E_FRONTEND_URL=https://<pr-preview>.vercel.app
# AUTH_E2E_BACKEND_URL=https://<pr-preview>.up.railway.app

# Server-side routing only. OSRM remains the compatibility default.
ROUTING_PROVIDER=osrm
GEOAPIFY_API_KEY=your-key-here

# Hugging Face Hub dataset read/write token (public repo read needs none)
HF_TOKEN=
GREENSENTINEL_BENCHMARK_HF_REPO=datamonsterr/green-sentinel-synthesized-trips

# ---- 14. Production Fraud Classifier (Slice W2) ----
FRAUD_CLASSIFIER_ENABLED=true
CLASSIFIER_LLM_ADVISORY=true
CLASSIFIER_ADVISORY_TIMEOUT_S=8.0
CLASSIFIER_BATCH_MAX=64

