{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-sentinel.local/eval/corpus/v1/corpus.schema.json",
  "title": "GreenSentinel Versioned Evaluation Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "source_revision", "label_boundary", "splits", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_version": {"type": "string", "pattern": "^eval-v[0-9]+$"},
    "source_revision": {"type": "string", "minLength": 7},
    "label_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_only", "runtime_projection"],
      "properties": {
        "evaluation_only": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "runtime_projection": {"type": "string", "minLength": 1}
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "tuning", "held_out"],
      "properties": {
        "train": {"$ref": "#/$defs/split"},
        "tuning": {"$ref": "#/$defs/split"},
        "held_out": {"$ref": "#/$defs/split"}
      }
    },
    "cases": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "may_tune"],
      "properties": {"purpose": {"type": "string", "minLength": 1}, "may_tune": {"type": "boolean"}}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "suite", "split", "leakage_group", "title", "execution", "provenance", "expected", "sme_review", "follow_up"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{4,79}$"},
        "suite": {"type": "string", "enum": ["operational_dic", "operational_traffic_false_alarm", "operational_technical_outage", "taxonomy_classifier", "rag", "tool", "brief", "role_error", "driver_a2a"]},
        "split": {"type": "string", "enum": ["train", "tuning", "held_out"]},
        "leakage_group": {"type": "string", "minLength": 3},
        "title": {"type": "string", "minLength": 3},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "fixture_ref", "input"],
          "properties": {
            "adapter": {"type": "string", "minLength": 1},
            "fixture_ref": {"type": "string", "minLength": 1},
            "input": {"type": "object"}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_kind", "source_ref", "source_version", "synthetic", "notes"],
          "properties": {
            "source_kind": {"type": "string", "enum": ["repository_fixture", "generated_fixture", "requirement_contract"]},
            "source_ref": {"type": "string", "minLength": 1},
            "source_version": {"type": "string", "minLength": 1},
            "synthetic": {"type": "boolean"},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["facts", "allowed_uncertainty", "policy_references", "guardrail", "action"],
          "properties": {
            "facts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string"}, "value": {}}}},
            "allowed_uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "policy_references": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source", "section"], "properties": {"source": {"type": "string"}, "section": {"type": "string"}}}},
            "guardrail": {"type": "object", "additionalProperties": false, "required": ["expected", "reason"], "properties": {"expected": {"type": "string", "enum": ["allow_review", "context_only", "block_punitive", "deny_action"]}, "reason": {"type": "string"}}},
            "action": {"type": "object", "additionalProperties": false, "required": ["expected", "human_confirmation_required", "punitive"], "properties": {"expected": {"type": "string"}, "human_confirmation_required": {"type": "boolean"}, "punitive": {"type": "boolean"}}}
          }
        },
        "sme_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer", "reviewed_at", "notes"],
          "properties": {
            "status": {"type": "string", "enum": ["pending", "approved", "rejected", "superseded"]},
            "reviewer": {"type": ["string", "null"]},
            "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "follow_up": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_layer", "suggested_issue_title"],
          "properties": {"owner_layer": {"type": "string", "enum": ["data", "context", "tool", "model", "graph", "policy", "ux", "test"]}, "suggested_issue_title": {"type": "string", "minLength": 5}}
        }
      }
    }
  }
}
